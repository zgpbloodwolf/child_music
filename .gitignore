# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
*.local

# 环境变量(本地/线上后端地址各自填写,不入库;模板见 .env.example)
# 连同 .env.local / .env.production 等变体一起排除,只放行模板 .env.example
.env
.env.*
!.env.example

# Editor directories and files
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# resource/ 是原始资源档案层:只保留说明文件与母带索引(约定与「有什么」要能被团队看到),
# 里面的原始音频与封面母带共约 1.26GB,整目录排除、切不可入库
/resource/*
!/resource/README.md
# 注意:被 /resource/* 排除的「目录」git 不会进入,所以否定规则对目录内的文件无效 ——
# 要把母带索引纳入版本管理,必须先把子目录本身放行,再单独放行该文件。
!/resource/song-covers-poetry/
/resource/song-covers-poetry/*
!/resource/song-covers-poetry/INDEX.json
src/static/library/
.hbuilderx/launch.json

# 后端服务(server/)
server/.env
server/.venv/
# 仓库根也曾建过一个 venv(仅 setuptools/pkg_resources,约 128MB),同样不入库
/.venv/
server/storage/
server/data/
server/**/__pycache__/
server/**/*.pyc

# 打包传输用的大文件(710MB 音频包,单独传服务器,不入库)
src/static.zip
.trae/

# CodeGraph 本地代码知识图谱索引(codegraph init 生成,每个机器各自一份)
.codegraph/
.claude/settings.json
__pycache__/
.workbuddy/

# 脚本生成的中间产物(server/scripts/import-erge.py 输出的导入映射表)
import-plan.json

# outputs/ 是封面制作流水线工作区(AI 原图、成品、临时脚本与验收报告,约 50MB),
# 成品已经管理接口入库到 server/storage/,本地保留、不入库
outputs/

